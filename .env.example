# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=pocketforge
DATABASE_URL=postgresql+asyncpg://user:password@localhost:15432/pocketforge

# Redis / Celery
REDIS_URL=redis://localhost:16379/0
CELERY_BROKER_URL=redis://localhost:16379/0
CELERY_RESULT_BACKEND=redis://localhost:16379/0

# Qdrant
QDRANT_URL=http://localhost:6335

# LLM Providers (Choose one or both)
GROQ_API_KEY=your_groq_api_key_here
# If using Ollama, ensure it's running locally on port 11434
OLLAMA_BASE_URL=http://localhost:11434
